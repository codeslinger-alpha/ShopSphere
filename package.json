{
  "name": "shopsphere",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "lint": "oxlint --deny-warnings server/src server/scripts && npm run lint --workspace client",
    "start": "npm start --workspace server",
    "db:seed": "npm run seed --workspace server",
    "test": "npm run test:integration --workspace server",
    "test:e2e": "npm run test:e2e --workspace client --",
    "db:init": "npm run init --workspace server",
    "db:reset": "npm run reset --workspace server",
    "docs:schema": "python3 scripts/document-schema.py"
  }
}
