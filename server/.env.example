PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere
DB_USER=postgres
DB_PASSWORD=replace-with-your-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Origins allowed to call the API from a browser, comma-separated. Each must match
# the address bar exactly: localhost and 127.0.0.1 are different origins, so list
# every one you serve the app from.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Print one line per request and per SQL statement to the terminal. Both are on by
# default outside production; set either to "false" to quiet it (the test scripts
# disable both).
LOG_SQL=true
LOG_REQUESTS=true
