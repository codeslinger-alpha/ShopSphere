node_modules/
.env
.env.*
!.env.example
client/dist/
client/test-results/
client/playwright-report/
# Playwright resolves its output directory against the working directory, so a
# run started from the repository root writes here rather than under client/.
test-results/
playwright-report/
*.log

# Tooling that belongs to whoever is working on this checkout rather than to the
# application: agent configuration, editor settings, and the delivery checklist.
# None of it is needed to install, build or run ShopSphere, so a clone should not
# inherit one person's setup.
.agents/
.claude/
.codex/
.vscode/
docs/CHECKLIST.md